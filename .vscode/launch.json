{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "java",
            "name": "Application",
            "request": "launch",
            "mainClass": "com.magu1436.chronolist.Application",
            "env": {
		"SPRING_PROFILES_ACTIVE": "dev",
            },
        },
        {
            "type": "java",
            "request": "launch",
            "name": "Spring Boot server",
            "mainClass": "com.magu1436.chronolist.Application",
            "projectName": "chronolist-backend",
            "console": "integratedTerminal",
            "env": {
		"SPRING_PROFILES_ACTIVE": "dev",
            },
        },
        {
            "type": "pwa-node",
            "request": "launch",
            "name": "Vite dev server",
            "cwd": "${workspaceFolder}/frontend",
            "runtimeExecutable": "npm",
            "runtimeArgs": [
                "run",
                "dev"
            ],
            "env": {
                "VITE_API_BASE_URL": "http://localhost:8080/",
            },
            "console": "integratedTerminal",
            "serverReadyAction": {
                "pattern": "Local:\\s+(https?://localhost:\\d+)",
                "uriFormat": "%s",
                "action": "openExternally"
            }
        }
    ],

    "compounds": [
        {
            "name": "Full Stack: Spring + Vite",
            "configurations": [
                "Spring Boot server",
                "Vite dev server",
            ],
            "stopAll": true,
        }
    ]
}