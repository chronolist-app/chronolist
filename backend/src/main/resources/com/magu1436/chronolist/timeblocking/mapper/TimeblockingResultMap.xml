<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.magu1436.chronolist.timeblocking.mapper.TimeblockingResultMap">

    <resultMap id="TimeBlockByIdResult"
        type="com.magu1436.chronolist.timeblocking.entity.TimeBlock" autoMapping="false">
        <id property="id" column="id" />
        <result property="userId" column="user_id" />
        <result property="timeTableId" column="time_table_id" />
        <result property="title" column="title" />
        <result property="status" column="status" />
        <result property="width" column="width" />
        <result property="startAt" column="start_at" />
        <result property="color" column="color" />
    </resultMap>

    <resultMap id="TimeTableResult"
        type="com.magu1436.chronolist.timeblocking.entity.TimeTable">
        <id property="id" column="table_id" />
        <result property="userId" column="table_user_id" />
        <result property="date" column="date" />
    </resultMap>

    <resultMap id="TimeBlockResult"
        type="com.magu1436.chronolist.timeblocking.entity.TimeBlock">
        <id property="id" column="block_id" />
        <result property="userId" column="block_user_id" />
        <result property="timeTableId" column="block_table_id" />
        <result property="title" column="block_title" />
        <result property="status" column="status" />
        <result property="width" column="width" />
        <result property="startAt" column="block_start_at" />
        <result property="color" column="color" />
        <collection property="tasks" ofType="com.magu1436.chronolist.timeblocking.entity.TimeBlockTask" >
            <id property="id" column="task_id" />
            <result property="timeBlockId" column="task_block_id" />
            <result property="title" column="task_title" />
        </collection>
    </resultMap>
</mapper>
