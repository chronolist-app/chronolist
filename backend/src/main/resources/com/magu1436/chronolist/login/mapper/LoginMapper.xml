<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.magu1436.chronolist.login.mapper.LoginMapper">
    <select id="getUsersByLoginId" resultType="com.magu1436.chronolist.login.entity.Users">
        SELECT id, login_id, password, role
        FROM users
        WHERE login_id = #{loginId}
    </select>

    <insert id="insertUser" useGeneratedKeys="true" keyProperty="id" parameterType="com.magu1436.chronolist.login.entity.Users">
        INSERT INTO users (login_id, password, role)
        VALUES
        (#{loginId}, #{password}, #{role})
    </insert>
</mapper>